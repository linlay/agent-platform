# Copy to .env and chmod 600. Compose reads it for the settings below and also
# passes it to the container as environment.

# Instance name: lowercase letters, digits and hyphens. The Compose project is
# agent-platform-<name>; it must be unique on this host and must not change
# afterwards.
AP_INSTANCE_NAME=

# Image tag to run; load.sh prints the value for this bundle.
AP_IMAGE_VERSION=__VERSION__

# Host address and port the service is published on. Keep the loopback
# address when a TLS reverse proxy on this host forwards to it.
AP_BIND_ADDRESS=127.0.0.1
AP_PORT=11949

# Host directory holding runtime/ and workspaces/. Both must be writable by
# UID/GID 10001.
AP_DATA_DIR=./data

# Resource limits.
AP_MEMORY_LIMIT=4g
AP_CPU_LIMIT=2
AP_PIDS_LIMIT=1024
AP_TMP_SIZE=1g
AP_HOME_SIZE=512m

# Signs chat resource tickets. Generate once, e.g. `openssl rand -hex 32`.
AP_CHAT_RESOURCE_TICKET_SECRET=
