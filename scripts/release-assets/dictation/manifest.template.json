{
  "kind": "builtin",
  "id": "agent-dictation",
  "name": "语音听写",
  "version": "__VERSION__",
  "description": "独立语音转文字服务，仅返回听写结果。",
  "platform": { "os": "__TARGET_OS__", "arch": "__TARGET_ARCH__" },
  "frontend": { "mode": "none" },
  "backend": { "entry": "__BACKEND_ENTRY__" },
  "lifecycle": {
    "start": ["__START_SCRIPT__", "--daemon"],
    "stop": "__STOP_SCRIPT__",
    "deploy": "__DEPLOY_SCRIPT__"
  },
  "configFiles": [
    { "key": "env", "label": ".env", "relativePath": ".env", "templateRelativePath": ".env.example", "required": true },
    { "key": "dictation", "label": "dictation.yml", "relativePath": "dictation.yml", "templateRelativePath": "dictation.example.yml", "required": true }
  ],
  "runtime": {
    "pidRelativePath": "run/agent-dictation.pid",
    "logRelativePath": "run/agent-dictation.log",
    "requiredPaths": ["__BACKEND_ENTRY__", "__START_SCRIPT__", "__STOP_SCRIPT__", "__DEPLOY_SCRIPT__", "__PROGRAM_COMMON__", ".env.example", "dictation.example.yml", "manifest.json"]
  },
  "web": { "routePath": "", "portEnvKey": "DICTATION_PORT", "defaultPort": 11964 },
  "desktop": {
    "ssoIdTokenFile": "v1",
    "autoStart": false,
    "displayOrder": 4,
    "assetFileName": "__ASSET_FILENAME__",
    "bundleTopLevelDir": "agent-dictation",
    "capabilities": {
      "provides": [],
      "requires": [{ "phase": "preStart", "capability": "auth.publicKey", "action": "copyFile", "target": "local-public-key.pem" }]
    }
  }
}
