{
  "version": 1,
  "operations": [
    {
      "operationId": "identity.whoami",
      "description": "identity.whoami",
      "effect": "read",
      "adapter": "cli",
      "cli": {
        "entry": "bin/libs/wecom-cli",
        "entryWindows": "bin/libs/wecom-cli.exe",
        "args": [
          "identity",
          "whoami"
        ],
        "dropFields": [
          "extra_identity_context"
        ],
        "textFields": [
          {
            "source": "extra_identity_context",
            "pattern": "授权真人用户身份：\\s*名字：(?P<userName>[^\\r\\n]+)\\s*ID：(?P<userId>[^\\r\\n]+)"
          }
        ]
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "userId",
          "userName"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "userName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "errcode": {
            "const": 0
          }
        }
      }
    },
    {
      "operationId": "calendar.schedules.list",
      "description": "calendar.schedules.list",
      "effect": "read",
      "adapter": "cli",
      "cli": {
        "entry": "bin/libs/wecom-cli",
        "entryWindows": "bin/libs/wecom-cli.exe",
        "args": [
          "calendar",
          "schedules",
          "list"
        ],
        "dropFields": [
          "extra_identity_context"
        ],
        "jsonFlag": "--json"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "begin_time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          }
        },
        "required": [
          "begin_time",
          "end_time"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schedule_list": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schedule_list_count": {
            "type": "integer"
          },
          "errcode": {
            "const": 0
          }
        },
        "anyOf": [
          {
            "required": [
              "schedule_list"
            ]
          },
          {
            "required": [
              "schedule_list_count"
            ]
          }
        ]
      }
    },
    {
      "operationId": "meeting.list",
      "description": "meeting.list",
      "effect": "read",
      "adapter": "cli",
      "cli": {
        "entry": "bin/libs/wecom-cli",
        "entryWindows": "bin/libs/wecom-cli.exe",
        "args": [
          "meeting",
          "list"
        ],
        "dropFields": [
          "extra_identity_context"
        ],
        "jsonFlag": "--json"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "begin_time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "begin_time",
          "end_time"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "created_meetings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "attended_meetings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          },
          "errcode": {
            "const": 0
          }
        },
        "required": [
          "has_more"
        ]
      }
    },
