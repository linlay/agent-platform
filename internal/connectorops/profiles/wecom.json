    {
      "operationId": "smartsheet.records.query",
      "description": "smartsheet.records.query",
      "effect": "read",
      "adapter": "cli",
      "cli": {
        "entry": "bin/libs/wecom-cli",
        "entryWindows": "bin/libs/wecom-cli.exe",
        "args": [
          "smartsheet",
          "records",
          "query"
        ],
        "dropFields": [
          "extra_identity_context"
        ],
        "parameters": [
          {
            "field": "docid",
            "flag": "--docid"
          },
          {
            "field": "sql",
            "flag": "--sql",
            "repeat": true,
            "readSQL": true
          }
        ]
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "docid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sql": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        "required": [
          "docid",
          "sql"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "errcode": {
            "const": 0
          }
        }
      }
    },
