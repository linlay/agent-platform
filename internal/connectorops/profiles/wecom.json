    {
      "operationId": "message.send",
      "description": "message.send",
      "effect": "write",
      "adapter": "cli",
      "cli": {
        "entry": "bin/libs/wecom-cli",
        "entryWindows": "bin/libs/wecom-cli.exe",
        "args": [
          "message",
          "aibot",
          "send"
        ],
        "dropFields": [
          "extra_identity_context"
        ],
        "jsonFlag": "--json"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "chat_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "msg_type": {
            "const": "markdown"
          },
          "markdown": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            },
            "required": [
              "content"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "chat_id",
          "msg_type",
          "markdown"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "errcode": {
            "const": 0
          }
        }
      }
