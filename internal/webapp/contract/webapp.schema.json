{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^webapp-[a-f0-9]{16}$"
    },
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "target": {
      "type": "string",
      "enum": [
        "any",
        "darwin-arm64",
        "darwin-x64",
        "darwin-universal",
        "linux-x64",
        "win32-arm64",
        "win32-x64"
      ]
    },
    "appConfig": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      },
      "x-desktop-maxBytes": 131072,
      "description": "Arbitrary JSON business configuration owned by the WebApp. Secrets are forbidden."
    },
    "userConfig": {
      "type": "object",
      "properties": {
        "fields": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "default": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "placeholder": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "maxLength": {
                    "default": 1024,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "maxLength"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "textarea"
                  },
                  "default": {
                    "type": "string",
                    "maxLength": 12000
                  },
                  "placeholder": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "maxLength": {
                    "default": 8000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12000
                  },
                  "rows": {
                    "default": 4,
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 12
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "maxLength",
                  "rows"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "default": 1,
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "step"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "default": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "default"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "select"
                  },
                  "options": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "default": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "select"
                  },
                  "source": {
                    "type": "string",
                    "const": "desktop.agents"
                  },
                  "default": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "required",
                  "type",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false,
      "x-desktop-maxBytes": 65536,
      "description": "Settings form definitions and non-secret defaults. Desktop stores actual user values separately."
    },
    "frontend": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "routeConfig": {
          "default": {
            "backendPrefixes": []
          },
          "type": "object",
          "properties": {
            "backendPrefixes": {
              "default": [],
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "navigationFallback": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "backendPrefixes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "root",
        "index",
        "routeConfig"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "command": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "electron-node"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "type",
                "entry"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "executable"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "type",
                "entry"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "runtime"
                },
                "runtime": {
                  "type": "string",
                  "enum": [
                    "python",
                    "java"
                  ]
                },
                "minimumVersion": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2}$"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "type",
                "runtime",
                "entry"
              ],
              "additionalProperties": false
            }
          ]
        },
        "args": {
          "default": [],
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "health": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "http"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^\\/(?!\\/)"
                },
                "startupTimeoutMs": {
                  "default": 10000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 120000
                }
              },
              "required": [
                "type",
                "path",
                "startupTimeoutMs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "tcp"
                },
                "startupTimeoutMs": {
                  "default": 10000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 120000
                }
              },
              "required": [
                "type",
                "startupTimeoutMs"
              ],
              "additionalProperties": false
            }
          ]
        },
        "shutdownTimeoutMs": {
          "default": 3000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        }
      },
      "required": [
        "command",
        "args",
        "env",
        "health",
        "shutdownTimeoutMs"
      ],
      "additionalProperties": false
    },
    "copilot": {
      "type": "object",
      "properties": {
        "agentKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "references": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "skill"
              },
              "id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "agentKey",
        "references"
      ],
      "additionalProperties": false
    },
    "desktopBridge": {
      "default": {
        "version": 1
      },
      "type": "object",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "kanbanRead": {
          "type": "boolean"
        },
        "connectorAuthentication": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "connectorExecution": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "connectorId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "adapter": {
                "type": "string",
                "enum": [
                  "cli",
                  "mcp"
                ]
              }
            },
            "required": [
              "connectorId",
              "adapter"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "key",
    "label",
    "version",
    "target",
    "appConfig",
    "frontend",
    "desktopBridge"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "Desktop WebApp Manifest v2",
  "description": "Desktop's authoritative host contract. Business configuration belongs in appConfig; editable user values are stored outside the package.",
  "x-desktop-manifestMaxBytes": 262144
}
