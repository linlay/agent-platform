{
  "views": {
    "agents": {
      "title": "Agents",
      "description": "List public Agents, including TEAM Agents.",
      "renderer": "html",
      "usage": [
        "display"
      ],
      "entry": "views/agents.html",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "all",
              "valid",
              "invalid"
            ],
            "description": "Initial status filter; default all."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size; default 20."
          }
        }
      },
      "queries": {
        "list": {
          "description": "List agents.",
          "adapter": "native",
          "operation": "catalog.list",
          "paramsSchema": {
            "type": "object",
            "required": [
              "resourceType"
            ],
            "additionalProperties": false,
            "properties": {
              "resourceType": {
                "enum": [
                  "agent"
                ]
              },
              "status": {
                "enum": [
                  "all",
                  "valid",
                  "invalid"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "type": "string"
              }
            }
          }
        }
      },
      "assets": [
        "views/list.css",
        "views/list.js"
      ]
    },
