    "html": "<section data-kind=\"card\" style=\"background:#fff; color:var(--fg);height:120px;border-left:2px solid var(--line);opacity:.9;box-shadow:0 2px 6px rgba(0,0,0,.2);font-family:'Helvetica Neue',sans-serif;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:clamp(100px,calc(100% - 4px),800px)\"><h5>Options</h5><input name=\"n\" list=\"choices\" autocomplete=\"off\" inputmode=\"numeric\"><datalist id=\"choices\"><option value=\"1\"></datalist></section>",
